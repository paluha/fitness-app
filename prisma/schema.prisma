// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  TRAINER
}

model User {
  id            String    @id @default(cuid())
  clientId      String?   @unique // Unique client identifier (e.g., "TX001")
  firstName     String?
  lastName      String?
  name          String?   // Display name (can be auto-generated from firstName + lastName)
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(CLIENT)
  language      String    @default("ru") // "ru" or "en"
  timezone      String    @default("Europe/Moscow")
  birthYear     Int?      // «О себе» для ИИ: год рождения (возраст)
  heightCm      Int?      // рост, см
  sex           String?   // "m" | "f"
  theme         String    @default("auto") // "light" | "dark" | "auto"
  goalType      String    @default("maintain") // "lose" | "maintain" | "gain" — цель питания, на неё опираются ИИ-рекомендации

  // Per-user daily nutrition goal. Used by macro progress bars, the food
  // recommender, and the day summary. Nulls fall back to the app-wide
  // defaults so existing users don't break before they open Profile.
  goalProtein   Int?
  goalFat       Int?
  goalCarbs     Int?
  goalCalories  Int?
  accounts      Account[]
  sessions      Session[]
  fitnessData   FitnessData?

  // Trainer-Client relationships
  trainerId     String?   // Client's assigned trainer
  trainer       User?     @relation("TrainerClients", fields: [trainerId], references: [id])
  clients       User[]    @relation("TrainerClients")

  // Program assigned by trainer
  programId     String?
  program       TrainingProgram? @relation("ClientProgram", fields: [programId], references: [id])

  // Programs created by trainer
  createdPrograms TrainingProgram[] @relation("TrainerPrograms")

  // Food products added by user
  addedFoodProducts FoodProduct[]

  // AI-чат: история сообщений с ассистентом
  chatMessages  ChatMessage[]
  chatAttachments ChatAttachment[]
  ouraConnection  OuraConnection?
  ouraDaily       OuraDaily[]

  // Лабораторные анализы (загруженные результаты)
  labResults    LabResult[]

  // Счётчики обращений к платным ИИ-роутам
  aiUsage       AiUsage[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Postgres не индексирует внешние ключи сам: без этих индексов
  // список клиентов тренера и отвязка программы шли полным сканом User.
  @@index([trainerId, role])
  @@index([programId])
}

// История AI-чата пользователя со своим фитнес-ассистентом.
// Сообщения сохраняются, чтобы пользователь видел переписку при возврате
// (как в Superpower). role: "user" | "assistant".
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Файл, присланный в чат: фото, PDF, текстовый документ.
//
// Раньше вложения жили только в самом запросе к модели — после отправки
// они исчезали, и вернуться к присланному анализу было невозможно.
// Храним data-URL целиком: файлы ограничены четырьмя штуками и ~3 МБ на
// сообщение, отдельное файловое хранилище ради этого не заводим.
//
// messageId — к какому сообщению относится; связь по id, без внешнего
// ключа, чтобы удаление истории не роняло загрузку вложений.
model ChatAttachment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String?
  name      String   // имя файла, как его прислал пользователь
  mimeType  String   // image/jpeg, application/pdf, text/plain…
  size      Int      // байты исходного файла — для списка и лимитов
  data      String   @db.Text // data-URL целиком
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([messageId])
}

// Подключение кольца Oura: токены доступа и обновления.
//
// Храним отдельной таблицей, а не в FitnessData: токены обновляются по
// своему расписанию и не должны ездить вместе с блобом тренировок.
model OuraConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  // Когда протухнет accessToken — обновляем заранее, не дожидаясь 401.
  expiresAt    DateTime
  scope        String?
  // Последняя успешная выгрузка: с неё продолжаем, чтобы не тянуть всё.
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Дневные показатели из Oura: сон, готовность, активность.
//
// Одна строка на день — повторная выгрузка перезаписывает её, поэтому
// синхронизацию можно запускать сколько угодно раз.
model OuraDaily {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            String   // YYYY-MM-DD, как и остальные даты в приложении

  // Сон
  sleepScore      Int?     // 0-100, общая оценка сна
  totalSleepMin   Int?     // всего сна, минут
  deepSleepMin    Int?
  remSleepMin     Int?
  sleepEfficiency Int?     // %, доля сна от времени в кровати
  bedtimeStart    DateTime?

  // Готовность и восстановление
  readinessScore  Int?     // 0-100
  restingHr       Int?     // пульс покоя
  hrvMs           Int?     // вариабельность, мс
  bodyTempDelta   Float?   // отклонение температуры тела, °C

  // Активность
  activityScore   Int?
  steps           Int?
  activeCalories  Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

// Результат лабораторного анализа пользователя.
// markers — массив показателей: [{ name, value, unit, refLow, refHigh, flag }]
// flag: "low" | "normal" | "high" — относительно референса.
model LabResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  panelName   String?  // "Metabolic Panel", "Lipid Panel" и т.п.
  lab         String?  // "Quest", "LabCorp", ...
  collectedAt DateTime // дата сдачи анализа
  markers     Json     // массив показателей (см. выше)
  fileUrl     String?  // ссылка/ключ на исходный PDF/фото (если хранится)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId, collectedAt])
}

model TrainingProgram {
  id                      String   @id @default(cuid())
  name                    String
  trainerId               String
  trainer                 User     @relation("TrainerPrograms", fields: [trainerId], references: [id])
  workouts                Json     // Array of workouts with exercises
  activeWorkoutDays       Int      @default(4) // How many days are active (e.g., 4 = T1-T4 active, T5-T7 rest)
  nutritionRecommendations Json?   // Array of nutrition timing recommendations from trainer
  clients                 User[]   @relation("ClientProgram")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([trainerId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FitnessData {
  id              String   @id @default(cuid())
  userId          String   @unique
  workouts        Json?    // User's workouts (T1-T7)
  dayLogs         Json     // Daily logs: steps, meals, completed workouts per date
  progressHistory Json?    // Exercise progress history
  bodyMeasurements Json?   // Body measurements history (weight, waist, biceps, etc.)
  favoriteMeals   Json?    // Array of favorite meal IDs
  plannerEvents   Json?    // Personal planner/calendar events
  exerciseLibrary Json?    // Exercise image library: { "exercise name": "base64 image" }
  habits          Json?    // Daily habit tracker
  programArchive  Json?    // История программ тренировок: [{id, archivedAt, label, workouts}]
  nutritionProfile Json?   // Анкета питания/здоровья: {conditions, intolerances, mealsPerDay, snacking, trainingTime, dietStyle, dislikes, notes, completedAt}
  vitals          Json?    // Показатели здоровья: [{id, at, systolic, diastolic, pulse, spo2, tags[], note}]
  /// Поля самонаблюдения, которые пользователь завёл сам:
  /// [{id, name, kind: 'scale'|'number'|'yesno', unit?, labels?, archived?}]
  checkinFields   Json?
  /// Значения этих полей по дням: [{id, date: 'YYYY-MM-DD', values: {fieldId: value}, note?}]
  checkinEntries  Json?
  /// Курсы препаратов: [{id, name, dose?, form?, schedule?, days?, remindAt?, startedAt?, endedAt?, note?}]
  medCourses      Json?
  /// Отметки приёма: [{id, courseId, at, dose?, note?}]
  medLogs         Json?
  recipes         Json?    // Рецепты пользователя: [{id, name, servings, ingredients[], steps[], perServing:{calories,protein,fat,carbs,sugar}, source, createdAt}]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Rolling backup of the full FitnessData blob, created on every successful save.
// Keeps the last N snapshots per user (trimmed by the write endpoint) so we can
// roll back when something goes wrong. This is a safety net on top of the
// single-row FitnessData design — it'll stop being critical once per-row
// writes ship in stage 2.
model FitnessSnapshot {
  id        String   @id @default(cuid())
  userId    String
  data      Json     // Full snapshot of FitnessData fields at that moment
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Per-exercise log — the granular replacement for dayLogs[date].workoutDraft.
// One row per (userId, date, exerciseId). Writes target a single row, so two
// devices editing different exercises can't clobber each other and a stale
// poll response can't wipe fresh edits.
//
// serverUpdatedAt is set server-side on every write; clients poll
// "since=<lastSeen>" to pull only changes they haven't seen yet.
// clientId identifies which device wrote the row (for tiebreaks / debugging).
model WorkoutLogEntry {
  id               String   @id @default(cuid())
  userId           String
  date             String   // YYYY-MM-DD (stored as text to dodge timezone bugs)
  exerciseId       String
  workoutId        String?  // Which workout template (T1-T7) this exercise belongs to that day
  completed        Boolean  @default(false)
  actualSets       Json?    // Array of { weight, reps, completed } objects — same shape the UI uses
  notes            String?  @db.Text
  clientId         String?  // Which device made the latest write
  clientUpdatedAt  DateTime // Client's wall clock at edit time (for conflict resolution)
  serverUpdatedAt  DateTime @updatedAt
  deletedAt        DateTime? // Soft-delete so tombstones can sync too

  @@unique([userId, date, exerciseId])
  @@index([userId, serverUpdatedAt])
  @@index([userId, date])
}

// Everything else in dayLogs that isn't per-exercise. One row per
// (userId, date, kind). kind is a short tag: "steps", "meals", "mood",
// "notes", "completedWorkouts", etc. payload holds the kind-specific shape.
// Smaller than one giant dayLogs JSON, but still flexible enough to grow
// without schema changes.
model DayLogEntry {
  id               String   @id @default(cuid())
  userId           String
  date             String   // YYYY-MM-DD
  kind             String   // "steps" | "meals" | "mood" | "notes" | "completedWorkouts" | etc
  payload          Json
  clientId         String?
  clientUpdatedAt  DateTime
  serverUpdatedAt  DateTime @updatedAt
  deletedAt        DateTime?

  @@unique([userId, date, kind])
  @@index([userId, serverUpdatedAt])
  @@index([userId, date])
}

enum FoodCategory {
  PROTEIN
  CARBS
  VEGETABLES
  DAIRY
  FATS
  FRUITS
}

model FoodProduct {
  id          String       @id @default(cuid())
  name        String
  category    FoodCategory
  addedById   String       // Who added it (trainer or client)
  addedBy     User         @relation(fields: [addedById], references: [id])
  trainerId   String?      // If added by trainer, show to all their clients
  isGlobal    Boolean      @default(false) // Show to everyone
  createdAt   DateTime     @default(now())

  @@index([trainerId])
  @@index([category])
}

/// Счётчик обращений к платным ИИ-роутам: защита счёта за API.
///
/// Храним в БД, а не в памяти процесса: на Vercel каждый запрос может
/// попасть в свой инстанс функции, и счётчик в переменной модуля там
/// не работает — лимит бы не срабатывал вообще.
///
/// Одна строка на (пользователь, роут, окно). Старые окна чистит
/// rateLimit() попутно, отдельная задача не нужна.
model AiUsage {
  id          String   @id @default(cuid())
  userId      String
  route       String   // 'chat', 'food-analyze', 'program', ...
  windowStart DateTime // начало минутного/суточного окна
  windowKind  String   // 'min' | 'day'
  count       Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, windowKind, windowStart])
  @@index([userId, route])
  @@index([windowStart])
}

/// Попытки входа по email — защита от подбора пароля.
///
/// Отдельно от AiUsage: там userId связан с User внешним ключом, а здесь
/// считать нужно ДО того, как пользователь опознан (и даже когда такого
/// аккаунта нет вовсе — иначе перебор по несуществующим адресам не
/// ограничен и выдаёт, какие адреса существуют).
model LoginAttempt {
  id          String   @id @default(cuid())
  email       String   // в нижнем регистре
  windowStart DateTime
  windowKind  String   // 'min' | 'hour'
  count       Int      @default(0)

  @@unique([email, windowKind, windowStart])
  @@index([windowStart])
}
